__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
*.egg-info/

# The PlantVillage images are ~2 GB and the task brief explicitly says not to
# commit them. data/README.md explains how to rebuild data/raw and the manifest.
data/raw/
data/meta/
data/manifest.csv
data/*.zip

# Training runs: weights, history and per-run config are regenerated by
# run_experiments.py. models/export/ is the exception - it is the small ONNX
# bundle the backend actually serves, and it is committed so the API can be
# deployed straight from a clone.
models/*/
!models/export/

node_modules/
frontend/dist/
frontend/.vite/

# Zipped copy of docs/report/latex/, made only for uploading to Overleaf.
# Regenerate it rather than committing it; the folder it duplicates is tracked.
docs/report/overleaf_project.zip

# LaTeX build output, in case anyone compiles the report locally.
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

.env
.env.*
!.env.example

.DS_Store
Thumbs.db
.idea/
.vscode/
