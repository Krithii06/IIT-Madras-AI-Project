# Copy to .env.local for local development, or set in the hosting provider's
# dashboard for a deployed build. Vite only exposes variables prefixed VITE_.
#
# Base URL of the FastAPI backend, with no trailing slash.
# Local:     http://localhost:8000
# Deployed:  https://<your-service>.onrender.com
VITE_API_URL=http://localhost:8000
